{
  "name": "pil-tactical-deployment",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-concurrency=1 scripts/*.test.mjs",
    "preview": "node scripts/preview.mjs",
    "deploy": "node scripts/deploy.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "policy:generate": "node scripts/render-policy.mjs",
    "policy:check": "node scripts/render-policy.mjs --check",
    "verify:package": "node scripts/verify-package.mjs",
    "test:receiver": "python3 -m unittest discover -s server -p test_*.py"
  }
}
